# 🤖 Job Auto-Apply Bot & Test Hub - Environment Variables Template
# Copy this file to .env and configure your values:
# cp .env.example .env

# Database Connection (PostgreSQL or leave unset for SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/jobs_bot

# Telegram Bot Notifications & Remote Commands
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Background Scan Frequency (in seconds)
SCAN_INTERVAL_SECONDS=3600

# Gmail IMAP Assessment Link Auto-Discovery (App Password)
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
